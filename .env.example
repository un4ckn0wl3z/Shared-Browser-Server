# Generate each secret independently with: openssl rand -hex 48
SHARED_BROWSER_ADMIN_TOKEN=
SHARED_BROWSER_DATA_KEY=

# The dashboard/API stays local by default. Caddy can publish it with HTTPS.
SHARED_BROWSER_HTTP_PUBLISH_IP=127.0.0.1

# Keep the forward proxy local, or set this to a private/VPN interface address.
# Never expose the proxy port openly to the internet.
SHARED_BROWSER_PROXY_PUBLISH_IP=127.0.0.1

# Required only when the optional Caddy HTTPS profile is enabled.
SHARED_BROWSER_DOMAIN=browser.example.com
